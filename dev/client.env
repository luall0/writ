# The `writ` client against the development daemon (`make run`). From the repo root:
#   source dev/client.env
export WRIT_HOME="$PWD/dev/data/client"          # sessions, known_hosts, tls_pins, approver.pub
export WRIT_URL=ssh://127.0.0.1:2222             # agents' listener
export WRIT_APPROVAL_URL=https://127.0.0.1:8443  # or ssh://127.0.0.1:2223
# Secretive's agent: only the key in $WRIT_HOME/approver.pub is ever used.
export WRIT_APPROVAL_AGENT="$HOME/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh"
